# Server
PORT=4000
HOST=0.0.0.0

# Postgres — set your real connection string locally in `.env` (gitignored).
# Single source of truth; no host/port/user/password split out.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Connection pool size (max simultaneous clients to Postgres)
# PGPOOL_MAX=16

# TLS for Postgres (default `verify` = CA-verified). `lenient` = encrypted
# without cert verification; `false` disables TLS — use only in trusted networks.
# DB_SSL=verify

# JWT signing — ALWAYS override in non-local environments
JWT_SECRET=dev-only-secret-change-me
JWT_EXPIRES=15m
REFRESH_EXPIRES_DAYS=14